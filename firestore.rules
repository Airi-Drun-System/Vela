rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function member() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function inChat(c) { return c.public == true || request.auth.uid in c.members; }

    match /meta/{d} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if member();
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.code == get(/databases/$(db)/documents/meta/invite).data.code
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24;
      allow update: if signed() && request.auth.uid == uid && request.resource.data.code == resource.data.code
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'photo', 'hue', 'seen', 'username'])
        && (!('username' in request.resource.data) || getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid)
        && (!('status' in request.resource.data) || request.resource.data.status.size() <= 70)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 80000
            && request.resource.data.photo.matches('data:image/jpeg;base64,.*')));
      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if member();
      allow create: if member() && name.matches('[a-z0-9_]{4,24}') && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.username == name;
      allow delete: if member() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('username', '') != name;
      allow update: if false;
    }

    match /chats/{cid} {
      allow get: if member() && (resource == null || inChat(resource.data));
      allow list: if member() && request.auth.uid in resource.data.members;
      allow create: if member() && (
        (cid == 'general' && request.resource.data.public == true && request.resource.data.members.size() == 0)
        || (request.resource.data.public == false && request.resource.data.members.size() == 2
            && request.auth.uid in request.resource.data.members
            && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            && exists(/databases/$(db)/documents/users/$(request.resource.data.members[0]))
            && exists(/databases/$(db)/documents/users/$(request.resource.data.members[1])))
        || (request.resource.data.group == true && request.resource.data.public == false
            && request.resource.data.owner == request.auth.uid && request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40));
      allow update: if member() && inChat(resource.data) && request.resource.data.public == resource.data.public
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 80000))
        && (!('about' in request.resource.data) || (request.resource.data.about is string && request.resource.data.about.size() <= 200))
        && (resource.data.get('group', false) != true || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40))
        && (request.resource.data.get('owner', '') == resource.data.get('owner', '') || resource.data.get('owner', '') == request.auth.uid)
        && (request.resource.data.members == resource.data.members
          || (resource.data.get('group', false) == true && resource.data.owner == request.auth.uid
              && request.auth.uid in request.resource.data.members && request.resource.data.members.size() <= 50)
          || (resource.data.get('group', false) == true
              && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())));
      allow delete: if false;

      function chat() { return get(/databases/$(db)/documents/chats/$(cid)).data; }

      match /sig/{sid} {
        allow create: if member() && inChat(chat()) && request.resource.data.from == request.auth.uid
          && request.resource.data.d is string && request.resource.data.d.size() <= 60000;
        allow read, delete: if member() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }

      match /files/{fid} {
        allow read: if member() && inChat(chat());
        allow create: if member() && inChat(chat()) && request.resource.data.uid == request.auth.uid
          && request.resource.data.n is int && request.resource.data.n <= 40;
        allow delete: if member() && resource.data.uid == request.auth.uid;
        match /parts/{p} {
          allow read: if member() && inChat(chat());
          allow create: if member() && inChat(chat())
            && get(/databases/$(db)/documents/chats/$(cid)/files/$(fid)).data.uid == request.auth.uid
            && request.resource.data.d is string && request.resource.data.d.size() <= 700000;
        }
      }

      match /messages/{mid} {
        allow read: if member() && inChat(chat());
        allow create: if member() && inChat(chat()) && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow update: if member() && inChat(chat()) && (
          (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 're'])
            && request.resource.data.text.size() <= 4000)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['re']));
        allow delete: if member() && resource.data.uid == request.auth.uid;
      }
    }

    match /calls/{id} {
      function party(d) { return request.auth.uid == d.from || request.auth.uid == d.to; }
      allow get, list: if member() && party(resource.data);
      allow create: if member() && request.resource.data.from == request.auth.uid
        && exists(/databases/$(db)/documents/users/$(request.resource.data.to)) && request.resource.data.state == 'ring';
      allow update: if member() && party(resource.data)
        && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to;
      match /{side}/{c} {
        allow read, create: if member() && party(get(/databases/$(db)/documents/calls/$(id)).data);
      }
    }
  }
}
